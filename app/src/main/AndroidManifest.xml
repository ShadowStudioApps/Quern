<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.CAMERA" />

    <queries>
        <package android:name="org.videolan.vlc" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <package android:name="com.brouken.player" />
        <package android:name="is.xyz.mpv" />
        <package android:name="live.mehiz.mpvkt" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <application
        android:name=".QuernApplication"
        android:allowBackup="false"
        android:banner="@drawable/prism_tv_banner_glossy"
        android:icon="@mipmap/ic_launcher_amoled"
        android:roundIcon="@mipmap/ic_launcher_amoled"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Quern"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- Base Activity (exported for deep links & explicit launches) -->
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode|locale|layoutDirection"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustNothing|stateHidden"
            android:theme="@style/Theme.Quern">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="stremio" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="quern"
                    android:host="link" />
            </intent-filter>
        </activity>

        <!-- Dynamic Launcher Icon 1: Slate Blue -->
        <activity-alias
            android:name=".IconSlateBlue"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_slate"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon 2: Light Gray (#D3D3D3) -->
        <activity-alias
            android:name=".IconLightGray"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_platinum"
            android:icon="@mipmap/ic_launcher_gray"
            android:roundIcon="@mipmap/ic_launcher_gray"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon 3: Glossy Black [Default] -->
        <activity-alias
            android:name=".IconAmoled"
            android:enabled="true"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_glossy"
            android:icon="@mipmap/ic_launcher_amoled"
            android:roundIcon="@mipmap/ic_launcher_amoled"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon 4: Ocean Blue (#2997FF) -->
        <activity-alias
            android:name=".IconOceanBlue"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_ocean"
            android:icon="@mipmap/ic_launcher_ocean"
            android:roundIcon="@mipmap/ic_launcher_ocean"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon 5: Aurora Gradient (Cyan -> Emerald -> Violet) -->
        <activity-alias
            android:name=".IconAuroraGradient"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_aurora"
            android:icon="@mipmap/ic_launcher_aurora"
            android:roundIcon="@mipmap/ic_launcher_aurora"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Dynamic Launcher Icon 6: Sunset Gradient (Rose -> Ember -> Gold) -->
        <activity-alias
            android:name=".IconSunsetGradient"
            android:enabled="false"
            android:exported="true"
            android:banner="@drawable/prism_tv_banner_sunset"
            android:icon="@mipmap/ic_launcher_sunset"
            android:roundIcon="@mipmap/ic_launcher_sunset"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
